# Copy to apps/api/.env and fill in. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16 (see docker-compose.yml)
DATABASE_URL=postgres://inother:inother_dev@localhost:5432/inother_dev
DATABASE_POOL_MAX=10

# Public origin of the web app (CORS, CSRF Origin check, email links). Must be https in production.
WEB_ORIGIN=http://localhost:3000
# true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false

# Generate each with: openssl rand -base64 32
# MASTER_KEY wraps all per-vault encryption keys. Losing it = losing all vault data. Use a KMS in production.
MASTER_KEY_BASE64=
MASTER_KEY_ID=local-v1
HMAC_SECRET_BASE64=

# Sessions
SESSION_COOKIE_NAME=__Host-inother_sid
SESSION_IDLE_TIMEOUT_MINUTES=1440
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
REAUTH_WINDOW_MINUTES=10

# Email: "log" (dev, logs only), "smtp" (production), "memory" (tests)
MAIL_TRANSPORT=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="InOther-side <no-reply@example.com>"

RATE_LIMIT_GLOBAL_PER_MINUTE=300
BODY_LIMIT_BYTES=262144

# Tests (optional override)
# TEST_DATABASE_URL=postgres://inother:inother_dev@localhost:5432/inother_test
