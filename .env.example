# Copy to apps/api/.env and fill in. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16 (see docker-compose.yml)
DATABASE_URL=postgres://inother:inother_dev@localhost:5432/inother_dev
DATABASE_POOL_MAX=10

# Public origin of the web app (CORS, CSRF Origin check, email links). Must be https in production.
WEB_ORIGIN=http://localhost:3000
# true only when running behind a trusted reverse proxy / load balancer
TRUST_PROXY=false

# Generate each with: openssl rand -base64 32
# MASTER_KEY wraps all per-vault encryption keys. Losing it = losing all vault data. Use a KMS in production.
MASTER_KEY_BASE64=
MASTER_KEY_ID=local-v1
HMAC_SECRET_BASE64=

# Sessions
SESSION_COOKIE_NAME=__Host-inother_sid
SESSION_IDLE_TIMEOUT_MINUTES=1440
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
REAUTH_WINDOW_MINUTES=10

# Email: "log" (dev, logs only), "smtp" (production), "memory" (tests)
MAIL_TRANSPORT=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="InOther-side <no-reply@example.com>"

# Media storage: "local" (dev/tests only) or "s3" (required in production; any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
# S3_BUCKET=inother-media
# S3_REGION=eu-central-1
# S3_ENDPOINT=                           # for S3-compatible providers; leave empty for AWS
# S3_FORCE_PATH_STYLE=false              # true for some S3-compatible providers
# S3_SSE_KMS_KEY_ID=                      # optional extra server-side encryption
# For S3 credentials use the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role.

# Redis for the media processing queue (worker: pnpm dev:worker)
REDIS_URL=redis://127.0.0.1:6379

# Malware scanning: "clamd" (required in production) or "noop" (dev only - NO scanning)
SCANNER=clamd
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=120000

# Per-vault media quota
MEDIA_QUOTA_BYTES=21474836480
MEDIA_MAX_FILES=1000

RATE_LIMIT_GLOBAL_PER_MINUTE=300
BODY_LIMIT_BYTES=262144

# Tests (optional override)
# TEST_DATABASE_URL=postgres://inother:inother_dev@localhost:5432/inother_test
# TEST_REDIS_URL=redis://127.0.0.1:6379/15
